function drawCandleChart(){const s=STOCKS.find(x=>x.id===openStockId);if(!s)return'';const ca=generateCandles(s,currentTimeframe,35);if(!ca.length)return'';const W=320,H=140;const mL=Math.min(...ca.map(c=>c.low)),mH=Math.max(...ca.map(c=>c.high)),r=(mH-mL)||1;const cw=W/ca.length,bw=Math.max(cw*0.7,4),pd=4;let sv=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="height:140px">`;for(let i=0;i<=4;i++){const y=pd+(H-2*pd)*i/4;sv+=`<line x1="0" y1="${y}" x2="${W}" y2="${y}" stroke="#1a2028" stroke-width="0.5"/>`;}ca.forEach((c,i)=>{const x=i*cw+cw/2;const yH=pd+((mH-c.high)/r)*(H-2*pd),yL=pd+((mH-c.low)/r)*(H-2*pd),yO=pd+((mH-c.open)/r)*(H-2*pd),yC=pd+((mH-c.close)/r)*(H-2*pd);const co=c.close>=c.open?'#0ecb81':'#f6465d';const bT=Math.min(yO,yC),bB=Math.max(yO,yC);sv+=`<line x1="${x}" y1="${yH}" x2="${x}" y2="${yL}" stroke="${co}" stroke-width="1.2"/>`;sv+=`<rect x="${x-bw/2}" y="${bT}" width="${bw}" height="${Math.max(bB-bT,1)}" fill="${co}" opacity="0.9"/>`;});sv+='</svg>';return sv;}

function drawBollingerChart(){
  const s=STOCKS.find(x=>x.id===openStockId);if(!s)return'';
  const ca=generateCandles(s,currentTimeframe,35);if(!ca.length)return'';
  const prices=ca.map(c=>c.close);
