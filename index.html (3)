/* ===== LIVE RANK: ترتيب اللاعبين ونسب الأرباح حينيًا ===== */
let _ttRankUnsub=null,_ttRankTimer=null,_ttRankList=null,_ttRankM=null,_ttRankLastPres=0,_ttRankLastPos=0,_ttRankHtml='',_ttMyHtml='';
function _ttMapLb(d,M){const x=d.data(),hidden=x.privacyHidden===true,bh=x.balanceHidden===true;const raw=Number(x[M+'Value']);
  return{uid:d.id,name:hidden?'متداول محمي':(cleanText(x.name)||'لاعب'),photo:hidden?null:cleanUrl(x.photo),avatarColor:hidden?'#5e6673':cleanColor(x.avatarColor),
    totalValue:bh?null:Math.max(0,Math.min(1e8,raw||STARTING_CASH)),profitPct:bh?null:Math.max(-100,Math.min(5000,Number(x[M+'Pct'])||0)),
    sortValue:isFinite(raw)&&raw>0?raw:STARTING_CASH,joined:x.joined||Date.now(),lastSeen:hidden?0:(x.lastSeen||0),
    xp:Math.max(0,Math.min(100000,Number(x.xp)||0)),badgesCount:Array.isArray(x.badges)?x.badges.length:0,hidden:hidden,balanceHidden:bh,isMe:d.id===(currentUser&&currentUser.id)};}
function ttStopRankLive(){if(_ttRankUnsub){try{_ttRankUnsub();}catch(e){}_ttRankUnsub=null;}if(_ttRankTimer){clearInterval(_ttRankTimer);_ttRankTimer=null;}}
function ttStartRankLive(M,initial){ttStopRankLive();if(currentTab!=='rank'||!fbDb||!document.getElementById('ttRankList'))return;
  _ttRankM=M;_ttRankHtml='';_ttMyHtml='';_ttRankLastPres=Date.now();_ttRankLastPos=0;
  _ttRankList=(initial||[]).map(p=>Object.assign({sortValue:p.totalValue==null?STARTING_CASH:p.totalValue},p));
  try{_ttRankUnsub=fbDb.collection('users').orderBy(M+'Value','desc').limit(33).onSnapshot(s=>{const l=[];s.forEach(d=>l.push(_ttMapLb(d,M)));if(l.length){_ttRankList=l;ttRankPaint();}},e=>{console.warn('rank snapshot',e);});}catch(e){}
  _ttRankTimer=setInterval(ttRankTick,2000);}
async function ttCountMyRank(M){try{const v=Math.max(0,portfolioTotalValue());const c=await fbDb.collection('users').where(M+'Value','>',v).count().get();window._myRank=c.data().count+1;window._rankTotal=Math.max(realStats.totalUsers||0,window._myRank);}catch(e){}}
function ttRankTick(){
  if(currentTab!=='rank'||!document.getElementById('ttRankList')||(getMarketMode()==='live'?'live':'practice')!==_ttRankM){ttStopRankLive();return;}
  const n=Date.now();
  if(n-_ttRankLastPres>15000){_ttRankLastPres=n;updatePresence(true);}
  if(n-_ttRankLastPos>10000){_ttRankLastPos=n;if(!(_ttRankList||[]).some(p=>p.isMe))ttCountMyRank(_ttRankM).then(ttRankPaint);fetchRealStats();}
  ttRankPaint();}
function ttRankPaint(){
  const box=document.getElementById('ttRankList');if(!box||!_ttRankList||typeof window.ttRankRow!=='function')return;
  const myVal=Math.max(0,portfolioTotalValue()),myPct=Math.max(-100,Math.min(5000,(myVal/STARTING_CASH-1)*100));
  const list=_ttRankList.map(p=>p.isMe?Object.assign({},p,{sortValue:myVal,totalValue:p.balanceHidden?null:Math.min(1e8,myVal),profitPct:p.balanceHidden?null:myPct,xp:userXP,lastSeen:Date.now()}):p)
    .sort((a,b)=>b.sortValue-a.sortValue);
  const rows=list.map(window.ttRankRow);
  const lh=rows.slice(0,10).join('')+(rows.length>10?'<div class="sec" style="margin-top:14px"><span class="sec-t">المراكز 11 – '+rows.length+'</span><span class="sec-line"></span></div>'+rows.slice(10).join(''):'');
