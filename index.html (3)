  for(let i=alerts.length-1;i>=0;i--){
    const a=alerts[i],s=STOCKS.find(x=>x.id===a.stockId);
    if(!s){alerts.splice(i,1);continue;}
    const hit=a.condition==='above'?s.price>=a.price:s.price<=a.price;
    if(hit){
      pushNotification('alert','تنبيه سعر',`${displayId(s)} وصل إلى ${fmt(s.price,3)} TND`);
      toast(displayId(s)+' وصل إلى '+fmt(s.price,3),'warn');
      const bell=document.getElementById('bellBtn');
      if(bell){bell.classList.add('shake');setTimeout(()=>bell.classList.remove('shake'),1600);}
      playAlertSound();alerts.splice(i,1);
    }
  }
}

