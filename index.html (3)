function adaptGetMastery(){const a=adaptiveState.attempts||{};const ids=Object.keys(a);if(!ids.length)return{overall:0,byLesson:{},weak:[]};const byLesson={};let total=0;ids.forEach(id=>{const avg=a[id].sum/a[id].count;byLesson[id]=avg;total+=avg;});const overall=total/ids.length;const weak=ids.filter(id=>byLesson[id]<70).sort((x,y)=>byLesson[x]-byLesson[y]);return{overall,byLesson,weak};}
function adaptGetNextQuestion(){const m=adaptGetMastery();let target=null;if(m.weak.length)target=m.weak[Math.floor(Math.random()*Math.min(3,m.weak.length))];else{const all=LESSONS.map(l=>l.id);const undone=all.filter(id=>!(lessonProgress.completed||{})[id]);if(undone.length)target=undone[0];}return target;}

