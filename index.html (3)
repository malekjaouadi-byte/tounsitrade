}
function startHistoryScenario(key){
  const sc=TT_HISTORY_SCENARIOS[key];if(!sc)return;
  _historyRun={key,index:0,steps:sc.steps.slice(),startValue:portfolioTotalValue()};
  renderHistoryProgress();
}
function renderHistoryProgress(){
  const e=document.getElementById('ttHistoryProgress');if(!e||!_historyRun)return;
  const sc=TT_HISTORY_SCENARIOS[_historyRun.key],done=_historyRun.index>=_historyRun.steps.length;
  e.innerHTML=`<div style="padding:12px;border:1px solid #333b45;border-radius:12px;line-height:1.8"><b>${sc.title}</b><div style="font-size:11px;color:#8b95a5">الخطوة ${Math.min(_historyRun.index+1,_historyRun.steps.length)} من ${_historyRun.steps.length}</div><div style="font-size:12px;margin:8px 0">${done?'انتهى السيناريو. قارن قيمة محفظتك قبل المسار وبعده.':'الحركة التالية: '+(_historyRun.steps[_historyRun.index]>0?'+':'')+_historyRun.steps[_historyRun.index]+'% على أسعار الأسهم الافتراضية.'}</div><button class="btn-primary" style="width:100%;background:#f0b90b;color:#0b0e11" ${done?'disabled':''} onclick="advanceHistoryScenario()">${done?'اكتمل السيناريو':'تطبيق الخطوة التالية'}</button><button class="btn-primary" style="width:100%;margin-top:7px;background:#1e252d;color:#eaecef;box-shadow:none" onclick="openHistoryScenarios()">اختيار سيناريو آخر</button></div>`;
}
function advanceHistoryScenario(){
  if(!_historyRun||_historyRun.index>=_historyRun.steps.length)return;
  const pct=_historyRun.steps[_historyRun.index++]/100;
  STOCKS.forEach(st=>{const factor=Math.max(.05,1+pct*(.65+((st.id.charCodeAt(0)||1)%6)/10));st.price=Math.max(.01,st.price*factor);st.chg=st.open?((st.price-st.open)/st.open)*100:st.chg;if(Array.isArray(st.spark)){st.spark.push(st.price);if(st.spark.length>120)st.spark.shift();}});
  MARKET.value=Math.max(1,MARKET.value*(1+pct));
  valueHistory.push({t:Date.now(),v:portfolioTotalValue()});if(valueHistory.length>2000)valueHistory.shift();
  saveState(true);renderHistoryProgress();updateHero();renderPortfolio();
}

