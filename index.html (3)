trackWeeklyEvent=function(kind,amount){if(!weeklyState.weekKey)rolloverWeeklyIfNeeded();const ws=weeklyState;if(amount===undefined)amount=1;
 if(kind==='trade')ws.tradesThisWeek=(ws.tradesThisWeek||0)+amount;
 else if(kind==='lesson')ws.lessonsThisWeek=(ws.lessonsThisWeek||0)+amount;
 else if(kind==='sl')ws.slPlacedThisWeek=(ws.slPlacedThisWeek||0)+amount;
 else if(kind==='winner')ws.winnersThisWeek=(ws.winnersThisWeek||0)+amount;
 else if(kind==='quiz'){ws.quizLessons=ws.quizLessons||[];if(ws.quizLessons.indexOf(amount)<0)ws.quizLessons.push(amount);}
 else if(kind==='journal'){ws.journalDays=ws.journalDays||[];if(ws.journalDays.indexOf(amount)<0)ws.journalDays.push(amount);}
 computeWeeklyProgress();saveState();};
