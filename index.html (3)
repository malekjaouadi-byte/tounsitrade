function getTunisiaTime(){
  try{
    const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Tunis',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).formatToParts(new Date());
    const g=k=>parseInt(parts.find(p=>p.type===k).value,10);
    return new Date(g('year'),g('month')-1,g('day'),g('hour'),g('minute'),g('second'));
  }catch(e){
    const n=new Date();
    return new Date(n.getTime()+(n.getTimezoneOffset()*60000)+3600000);
  }
}
