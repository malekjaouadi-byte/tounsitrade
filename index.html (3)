/* إعدادات الخصوصية: تطبيق محلي فوري ثم مزامنة Firebase دون تعطيل الزر */
function ttSavePrivacyLocal(field,value){
  if(!currentUser||!currentUser.id)return;
  try{localStorage.setItem('tt_priv_'+field+'_'+currentUser.id,value?'1':'0');}catch(e){}
}
function ttPrivacyToast(msg){try{toast(msg,'good');}catch(e){console.log(msg);}}
async function togglePrivacy(){
  if(!currentUser){toast('سجّل الدخول أولًا','warn');return;}
  const nextValue=currentUser.balanceHidden!==true;
  currentUser.balanceHidden=nextValue;
  ttSavePrivacyLocal('balanceHidden',nextValue);
  try{ttLbInvalidate();}catch(e){}
  // Re-render profile immediately so the switch visibly changes in both market modes.
  try{openProfile();}catch(e){}
  try{if(currentTab==='rank')renderRank();}catch(e){}
  if(!fbDb){ttPrivacyToast(nextValue?'تم إخفاء قيمة المحفظة على هذا الجهاز':'تم إظهار قيمة المحفظة');return;}
  try{
    await fbDb.collection('users').doc(currentUser.id).set({balanceHidden:nextValue,updatedAt:Date.now()},{merge:true});
    try{await updatePresence(true);}catch(e){console.warn('presence refresh after privacy save',e);}
    try{ttLbInvalidate();if(currentTab==='rank')await renderRank();}catch(e){}
    ttPrivacyToast(nextValue?'تم إخفاء قيمة المحفظة ونسبة الربح في الترتيب':'أصبحت قيمة المحفظة ونسبة الربح ظاهرتين في الترتيب');
  }catch(e){console.error('portfolio visibility save failed',e);toast('تم تطبيق الإعداد محليًا، لكن تعذّر حفظه في Firebase. تحقق من الاتصال والصلاحيات','warn');}
}
async function toggleNamePrivacy(){
  if(!currentUser){toast('سجّل الدخول أولًا','warn');return;}
  const nextValue=currentUser.privacyHidden!==true;
  currentUser.privacyHidden=nextValue;
