function _bulkSellExec(ids){
  const pos=[];
  ids.forEach(id=>{const s=STOCKS.find(x=>x.id===id),h=holdings[id];if(!h)return;if(!s){delete holdings[id];return;}
    const f=ttCalculateFees(s.price,h.qty),cost=h.avg*h.qty;
    pos.push({id,s,qty:h.qty,cost,profit:f.stockValue-f.totalFees-cost});});
  pos.forEach(p=>{addTrade(p.id,'sell',p.qty,p.s.price);delete holdings[p.id];trackWeeklyEvent('trade');});
  return pos;
}
function _bulkSellRewards(pos){
  pos.forEach(p=>{if(p.profit>0){unlockBadge('first_profit');trackWeeklyEvent('winner');}if(p.profit!==0)awardPnL(p.profit,p.cost);});
  if(recentTrades.length>=10)unlockBadge('ten_trades');
}
async function sellAll(){
  if(!isTradingAllowed())return toast('السوق مغلق','warn');
  const entries=Object.entries(holdings);
  if(!entries.length)return toast('لا تملك أي مركز');
  let ts=0,tf=0;entries.forEach(([id,h])=>{const s=STOCKS.find(x=>x.id===id);if(s){ts+=s.price*h.qty;const f=ttCalculateFees(s.price,h.qty);tf+=f.totalFees;}});
  const net=ts-tf,exit=cash+net,pnl=exit-STARTING_CASH;
  if(!(await askConfirm(`بيع الكل؟\nستستلم: ${fmt(net)} TND\nرصيدك الجديد: ${fmt(exit)} TND`)))return;
  const ids=entries.map(([id])=>id);
  const _pos=_bulkSellExec(ids);
  pendingOrders=pendingOrders.filter(o=>{
    if(o.type==='sl')return false;
    if(o.type==='buy'&&ids.includes(o.stockId)){cash+=Number(o.reserveCost)||0;return false;}
    return true;
  });
  cash+=net;_bulkSellRewards(_pos);saveState();renderPortfolio();updateHero();toast(`تم البيع. رصيدك: ${fmt(cash)} TND`,'good');
}
async function sellWinners(){if(!Object.entries(holdings).some(([id,h])=>{const z=STOCKS.find(x=>x.id===id);return z&&z.price>h.avg;}))return toast('لا توجد مراكز رابحة حاليًا');
  if(!isTradingAllowed())return toast('السوق مغلق','warn');
  const ids=Object.entries(holdings).filter(([id,h])=>{const s=STOCKS.find(x=>x.id===id);return s&&s.price>h.avg;}).map(([id])=>id);
  if(!ids.length)return toast('لا يوجد أسهم رابحة');
  let ts=0,tf=0;ids.forEach(id=>{const s=STOCKS.find(x=>x.id===id);if(s){ts+=s.price*holdings[id].qty;const f=ttCalculateFees(s.price,holdings[id].qty);tf+=f.totalFees;}});
  const net=ts-tf,cost=ids.reduce((sm,id)=>sm+holdings[id].avg*holdings[id].qty,0);
  const profit=net-cost;
  if(!(await askConfirm(`بيع الرابحة؟\nستستلم: ${fmt(net)} TND\nالربح: +${fmt(profit)} TND`)))return;
