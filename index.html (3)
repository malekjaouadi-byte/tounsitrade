  const W=320,H=140,pd=6;
  const mH=Math.max(...ca.map(c=>c.high),bb?bb.upper:0);
  const mL=Math.min(...ca.map(c=>c.low),bb?bb.lower:Infinity);
  const r=(mH-mL)||1;const cw=W/ca.length,bw=Math.max(cw*0.7,4);
  const y=v=>pd+((mH-v)/r)*(H-2*pd);
  let sv=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="height:140px">`;
  for(let i=0;i<=4;i++){const y2=pd+(H-2*pd)*i/4;sv+=`<line x1="0" y1="${y2}" x2="${W}" y2="${y2}" stroke="#1a2028" stroke-width="0.5"/>`;}
  if(bb){const off=ca.length-20;const yU=y(bb.upper),yM=y(bb.middle),yL=y(bb.lower);const xS=off*cw+cw/2,xE=W-cw/2;sv+=`<rect x="${xS}" y="${yU}" width="${xE-xS}" height="${yL-yU}" fill="#3b82f6" opacity="0.06"/>`;sv+=`<line x1="${xS}" y1="${yU}" x2="${xE}" y2="${yU}" stroke="#3b82f6" stroke-width="1.2" opacity="0.75" stroke-dasharray="4,3"/>`;sv+=`<line x1="${xS}" y1="${yM}" x2="${xE}" y2="${yM}" stroke="#f0b90b" stroke-width="1.2" opacity="0.8"/>`;sv+=`<line x1="${xS}" y1="${yL}" x2="${xE}" y2="${yL}" stroke="#3b82f6" stroke-width="1.2" opacity="0.75" stroke-dasharray="4,3"/>`;}
  ca.forEach((c,i)=>{const x=i*cw+cw/2;const yH=y(c.high),yL=y(c.low),yO=y(c.open),yC=y(c.close);const co=c.close>=c.open?'#0ecb81':'#f6465d';const bT=Math.min(yO,yC),bB=Math.max(yO,yC);sv+=`<line x1="${x}" y1="${yH}" x2="${x}" y2="${yL}" stroke="${co}" stroke-width="1"/>`;sv+=`<rect x="${x-bw/2}" y="${bT}" width="${bw}" height="${Math.max(bB-bT,1)}" fill="${co}" opacity="0.9"/>`;});
  sv+='</svg>';return sv;
}

function drawMACDChart(){
  const s=STOCKS.find(x=>x.id===openStockId);if(!s)return'';
  const ca=generateCandles(s,currentTimeframe,60);if(ca.length<35)return'<div style="text-align:center;color:#5e6673;font-size:11px;padding:20px">بيانات غير كافية</div>';
  const prices=ca.map(c=>c.close);
  const m=computeMACD(prices);
  if(!m)return'<div style="text-align:center;color:#5e6673;font-size:11px;padding:20px">بيانات غير كافية</div>';
  const W=320,H=100,pd=6;
  const all=[...m.macdLine,...m.signal,...m.histogram];
  const mx=Math.max(...all),mn=Math.min(...all),r=(mx-mn)||1;
  const y=v=>pd+((mx-v)/r)*(H-2*pd);
  const zeroY=y(0);const cw=W/(m.macdLine.length);
  let sv=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="height:100px">`;
  sv+=`<line x1="0" y1="${zeroY}" x2="${W}" y2="${zeroY}" stroke="#2e3742" stroke-width="0.7"/>`;
  m.histogram.forEach((v,i)=>{const x=i*cw+cw/2;const col=v>=0?'#0ecb81':'#f6465d';const yy=y(v);const h=Math.abs(yy-zeroY);sv+=`<rect x="${x-cw*0.3}" y="${Math.min(yy,zeroY)}" width="${cw*0.6}" height="${Math.max(h,0.5)}" fill="${col}" opacity="0.55"/>`;});
  const ptsM=m.macdLine.map((v,i)=>`${(i*cw+cw/2).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
  sv+=`<polyline points="${ptsM}" fill="none" stroke="#3b82f6" stroke-width="1.5"/>`;
  const off=m.macdLine.length-m.signal.length;
  const ptsS=m.signal.map((v,i)=>`${((i+off)*cw+cw/2).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
  sv+=`<polyline points="${ptsS}" fill="none" stroke="#f0b90b" stroke-width="1.5"/>`;
  sv+='</svg>';return sv;
}

