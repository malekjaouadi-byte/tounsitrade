 if(old<1500&&userXP>=1500){pushNotification('rank','👑 وصلت النخبة!','انخفضت عمولة الوسيط لديك إلى 0.15% 👑');try{toast('👑 عمولتك الآن 0.15%','good');}catch(e){}}
 saveState();};
