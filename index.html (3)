  if(mode==='live'){const open=isMarketOpen();if(!open&&isPreOpen()){el.className='market-status';el.style.background='linear-gradient(135deg,rgba(240,185,11,.15),rgba(240,185,11,.05))';el.style.border='1px solid rgba(240,185,11,.4)';el.style.color='#f0b90b';txt.textContent='ما قبل الافتتاح (أوامر فقط)';tm.textContent='⏱ الافتتاح بعد '+formatDuration(getTimeUntilOpen());}else if(open){el.className='market-status live';txt.textContent=isM?'السوق (يدوي)':'السوق مفتوح';tm.textContent='⏱ '+formatDuration(getTimeUntilClose());}else{el.className='market-status';el.style.background='linear-gradient(135deg,rgba(94,102,115,.15),rgba(94,102,115,.05))';el.style.border='1px solid rgba(94,102,115,.4)';el.style.color='#8b95a5';txt.textContent='السوق مغلق (وضع حقيقي)';tm.textContent='⏱ ما قبل الافتتاح بعد '+formatDuration(getTimeUntilPreOpen());}}
  else{el.className='market-status practice';txt.textContent=isM?'التدريب (يدوي)':'وضع التدريب';if(isM&&am!=='practice')tm.textContent='يدوي';else tm.textContent='⏱ يفتح بعد '+formatDuration(getTimeUntilOpen());}
  if(lastMarketMode!==null&&lastMarketMode!==mode){saveModeState();loadModeState(mode);if(mode==='live'){pushNotification('rank','السوق فتح','أنت الآن في الوضع الحقيقي.');toast('السوق فتح','good');}else{pushNotification('rank','وضع التدريب','أنت الآن في وضع التدريب.');toast('وضع التدريب','warn');}if(currentUser)render();}
  lastMarketMode=mode;
}

