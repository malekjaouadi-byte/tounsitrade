getWeeklyChallenge=function(){let c=WEEKLY_CHALLENGES.find(x=>x.id===weeklyState.challengeId);if(!c){c=pickChallengeForWeek(weeklyState.weekKey||getWeekKey());weeklyState.challengeId=c.id;}return c;};
computeWeeklyProgress=function(){const ch=getWeeklyChallenge(),ws=weeklyState;let p=0;
 if(ch.type==='sl_cover')p=Object.keys(holdings).filter(id=>holdings[id]&&holdings[id].qty>0&&pendingOrders.some(o=>o.type==='sl'&&o.stockId===id)).length;
 else if(ch.type==='sectors_held'){const s=new Set();Object.keys(holdings).forEach(id=>{const st=STOCKS.find(x=>x.id===id);if(st&&holdings[id].qty>0)s.add(st.sector);});p=s.size;}
 else if(ch.type==='quiz_pass')p=(ws.quizLessons||[]).length;
 else if(ch.type==='winning_calm')p=(ws.tradesThisWeek||0)<=8?(ws.winnersThisWeek||0):0;
 else if(ch.type==='journal_days')p=(ws.journalDays||[]).length;
 ws.progress=Math.min(p,ch.target);return ws.progress;};
