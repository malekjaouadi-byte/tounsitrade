 const all=Object.keys(QUIZ_BANK);if(!all.length)return toast('لا يوجد محتوى');
 const pool=[];all.forEach(id=>{QUIZ_BANK[id].forEach(q=>pool.push({lessonId:id,q}));});
 const wrong=lsG('wq',{}),first=pool.filter(p=>wrong[p.lessonId+'|'+p.q[0]]);
 const picked=shuffleArray(first).slice(0,4);
 const rest=shuffleArray(pool.filter(p=>picked.indexOf(p)<0));
 while(picked.length<10&&rest.length)picked.push(rest.shift());
 activeQuiz={lessonId:'__mixed__',idx:0,answers:[],score:0,total:picked.length,mixed:picked,shuffledOptions:null,newCorrectIdx:0};
 closeSheet();setTimeout(()=>renderMixedModal(),50);
};

