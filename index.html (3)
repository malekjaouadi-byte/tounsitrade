  if(!(await askConfirm(`بيع الخاسرة؟\nستستلم: ${fmt(net)} TND\nالخسارة: ${fmt(loss)} TND`)))return;
  const _pos=_bulkSellExec(ids);
  pendingOrders=pendingOrders.filter(o=>o.type!=='sl'||!ids.includes(o.stockId));
  cash+=net;_bulkSellRewards(_pos);saveState();renderPortfolio();updateHero();toast(`تم بيع الخاسرة. ${fmt(loss)} TND`,'warn');
}

