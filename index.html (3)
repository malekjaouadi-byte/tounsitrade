chStatus=function(){const ids=Object.keys(holdings).filter(id=>holdings[id]&&holdings[id].qty>0);
 const allSL=ids.length>0&&ids.every(id=>pendingOrders.some(o=>o.type==='sl'&&o.stockId===id));
