/* ---------- 8) Knowledge ranking ---------- */
window.ttSetRankView=function(v){window._rankView=v;renderRank();};
function ttRankToggle(){const v=window._rankView==='know'?'know':'perf';return '<div class="mkt-seg"><div class="mkt-seg-row"><button class="'+(v==='perf'?'on prac':'')+'" onclick="ttSetRankView(\'perf\')">💰 الأداء</button><button class="'+(v==='know'?'on prac':'')+'" onclick="ttSetRankView(\'know\')">🎓 المعرفة</button></div></div>';}
async function renderKnowledgeRank(){
 view.innerHTML='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><button onclick="document.querySelector(\'.tab[data-tab=market]\').click()" style="padding:9px 14px;border:none;border-radius:11px;background:#1c222a;color:#eaecef;font-weight:800;font-family:inherit;cursor:pointer">← رجوع</button><span style="font-size:12px;color:#f0b90b;font-weight:800">ترتيب المعرفة</span></div>'+ttRankToggle()+ttSkeleton(6);
 let rows=[];
 try{const s=await fbDb.collection('users').orderBy('xp','desc').limit(20).get();s.forEach(d=>{const x=d.data(),me=d.id===currentUser.id,hid=x.privacyHidden===true;rows.push({me,hid,name:hid?'متداول محمي':(cleanText(x.name)||'لاعب'),xp:me?userXP:Math.max(0,Math.min(100000,Number(x.xp)||0)),b:me?userBadges.length:(Array.isArray(x.badges)?x.badges.length:0)});});}catch(e){rows=null;}
 const head=view.innerHTML.split(ttSkeleton(6))[0];
 if(!rows){view.innerHTML=head+'<div class="pf-empty"><div class="ico">⚠️</div><div>تعذّر تحميل الترتيب</div></div>';return;}
 rows.sort((a,b)=>b.xp-a.xp);
 view.innerHTML=head+'<div style="font-size:11px;color:#8b95a5;line-height:1.8;margin-bottom:10px">يُحسب من الدروس والاختبارات والشارات والتحديات — لا من الأرباح فقط.</div>'+(rows.length?rows.map((r,i)=>'<div class="rank-card '+(r.me?'me':'')+'"><div class="rank-num '+(i===0?'gold':i===1?'silver':i===2?'bronze':'')+'">'+(i===0?'🥇':i===1?'🥈':i===2?'🥉':i+1)+'</div><div class="rank-info" style="'+(r.hid?'color:#5e6673':'')+'">'+r.name+(r.me&&!r.hid?' <span style="color:#f0b90b">· أنت</span>':'')+' '+(r.hid?'':ttTierBadge(r.xp,true))+'<div class="meta">🏆 '+r.b+' شارة</div></div><div class="rank-value"><div class="v">'+r.xp+' XP</div></div></div>').join(''):'<div class="pf-empty"><div class="ico">🎓</div><div>لا بيانات بعد</div></div>')+'<div class="disc">الترتيب يعرض المستخدمين الحقيقيين فقط.</div>';
}
const _rr1=renderRank;
renderRank=async function(){if(window._rankView==='know')return renderKnowledgeRank();await _rr1.apply(this,arguments);try{view.insertAdjacentHTML('afterbegin',ttRankToggle());}catch(e){}};
window.renderRank=renderRank;
const _str=switchToRank;
switchToRank=function(){window._rankView='perf';return _str.apply(this,arguments);};
})();

