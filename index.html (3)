function updateSheetLive(){
  const s=STOCKS.find(x=>x.id===openStockId);if(!s)return;
  const dc=s.price<1?4:3;
  const p=document.getElementById('shPrice'),c=document.getElementById('shChg');
  if(p)p.innerHTML=fmt(s.price,dc)+' <span style="font-size:14px;color:#5e6673">TND</span>';
  if(c){c.textContent=fmtPct(s.chg)+' اليوم';c.className='sh-chg '+cls(s.chg);}
  const cb=document.getElementById('candleBox');if(cb)cb.innerHTML=renderIndicatorChart();
  const vb=document.getElementById('volumeBox');if(vb)vb.innerHTML=drawVolume();
  const rb=document.getElementById('rsiChartBox');if(rb)rb.innerHTML=drawRSIChart();
  const rsi=computeRSI(s.spark);
  const rv=document.getElementById('rsiVal');if(rv){rv.textContent=rsi.toFixed(1);rv.style.color=rsi<30?'#0ecb81':rsi>70?'#f6465d':'#f0b90b';}
  const ob=document.getElementById('orderBookBox');if(ob)ob.innerHTML=renderOrderBook(s);
  const sr=document.getElementById('srBox');
  if(sr&&sheetIndicator==='sr')sr.innerHTML=renderSupportResistance();
  // FIX #5: تحديث حالة أزرار الشراء/البيع
  const q=currentQty();
  const total=q*s.price;
  const tOk=isTradingAllowed();
  const h=holdings[s.id];
  const canBuy=(total<=cash&&q>0)&&tOk;
  const canSell=(h&&h.qty>=q-0.0001)&&tOk;
  const bb=document.getElementById('btnBuy'),bs=document.getElementById('btnSell');
  if(bb)bb.disabled=!canBuy;
  if(bs)bs.disabled=!canSell;
}

