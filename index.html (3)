function openHistoryScenarios(){
  sheetBody.innerHTML=`<div class="sh-head"><div><div class="sh-tk">📉 مختبر السوق</div><div class="sh-nm">سيناريوهات تعليمية افتراضية</div></div><button class="sh-close" onclick="closeSheet()">×</button></div>
