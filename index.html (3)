/* ============================================================
   INDICATORS
   ============================================================ */
function computeRSI(prices,period=14){if(prices.length<period+1)return 50;let g=0,l=0;for(let i=prices.length-period;i<prices.length;i++){const d=prices[i]-prices[i-1];if(d>0)g+=d;else l-=d;}if(l===0)return 100;const rs=(g/period)/(l/period);return 100-(100/(1+rs));}
function computeRSISeries(spark,period=14){const result=[];const slice=spark.slice(-60);for(let i=period;i<slice.length;i++){let g=0,l=0;for(let j=i-period+1;j<=i;j++){const d=slice[j]-slice[j-1];if(d>0)g+=d;else l-=d;}if(l===0)result.push(g===0?50:100);else{const rs=(g/period)/(l/period);result.push(100-(100/(1+rs)));}}return result;}
function computeEMA(prices,period){if(prices.length<period)return[];const k=2/(period+1);const ema=[prices.slice(0,period).reduce((a,b)=>a+b,0)/period];for(let i=period;i<prices.length;i++)ema.push(prices[i]*k+ema[ema.length-1]*(1-k));return ema;}
function computeMACD(prices){if(prices.length<35)return null;const ema12=computeEMA(prices,12);const ema26=computeEMA(prices,26);const offset=ema12.length-ema26.length;const macdLine=ema26.map((v,i)=>ema12[i+offset]-v);const signal=computeEMA(macdLine,9);const sigOffset=macdLine.length-signal.length;const histogram=signal.map((s,i)=>macdLine[i+sigOffset]-s);return{macdLine,signal,histogram};}
function computeBollinger(prices,period=20,mult=2){if(prices.length<period)return null;const slice=prices.slice(-period);const mean=slice.reduce((a,b)=>a+b,0)/period;const variance=slice.reduce((a,b)=>a+Math.pow(b-mean,2),0)/period;const sd=Math.sqrt(variance);return{upper:mean+mult*sd,middle:mean,lower:mean-mult*sd,sd,mean};}

/* FIX #9: generateCandles بدون تعبئة عشوائية */
let chZoom=1,chOff=0;
function generateCandles(s,tf='1m',c=35){seedCandles(s);const a=s.candles[tf]||s.candles['1m'];const n=Math.min(a.length,Math.max(20,Math.round(c/chZoom)));chOff=Math.max(0,Math.min(chOff,a.length-n));return a.slice(a.length-n-chOff,a.length-chOff).map(x=>({open:x.open,high:x.high,low:x.low,close:x.close,volume:x.volume}));}

function findPivots(spark,lookback=3){const pivots=[];const n=spark.length;for(let i=lookback;i<n-lookback;i++){let isHigh=true,isLow=true;for(let j=1;j<=lookback;j++){if(spark[i]<=spark[i-j]||spark[i]<=spark[i+j])isHigh=false;if(spark[i]>=spark[i-j]||spark[i]>=spark[i+j])isLow=false;}if(isHigh)pivots.push({i,v:spark[i],type:'high'});if(isLow)pivots.push({i,v:spark[i],type:'low'});}return pivots;}
function clusterLevels(pivots,threshold=0.008){const levels=[];pivots.forEach(p=>{const ex=levels.find(l=>Math.abs(l.v-p.v)/l.v<threshold);if(ex){ex.touches++;ex.v=(ex.v*ex.touches+p.v)/(ex.touches+1);}else levels.push({v:p.v,touches:1,type:p.type});});return levels.filter(l=>l.touches>=2).sort((a,b)=>b.v-a.v);}

