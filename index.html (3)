function _wq(lessonId,text,ok){try{const m=lsG('wq',{}),k=lessonId+'|'+text;if(ok){if(m[k]){delete m[k];lsS('wq',m);}}else{m[k]=Date.now();const ks=Object.keys(m);if(ks.length>60)delete m[ks.sort((a,b)=>m[a]-m[b])[0]];lsS('wq',m);}}catch(e){}}
function _expl(q){const fb=document.getElementById('quizFeedback');if(fb&&q&&q[3]){fb.style.whiteSpace='pre-line';fb.textContent+='\n💡 '+q[3];}}
const _aq=answerQuiz;
answerQuiz=function(i){const b=getQuizFor(activeQuiz.lessonId),q=b&&b[activeQuiz.idx];if(!q)return _aq(i);_wq(activeQuiz.lessonId,q[0],i===activeQuiz.newCorrectIdx);_aq(i);_expl(q);};
