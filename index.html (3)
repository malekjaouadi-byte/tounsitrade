async function _doBuyCore(){
  if(!isTradingAllowed())return toast('السوق مغلق','warn');
  const s=STOCKS.find(x=>x.id===openStockId);const q=Number(currentQty());
  if(!s||!Number.isFinite(Number(s.price))||Number(s.price)<=0)return toast('تعذّر التحقق من سعر السهم. حدّث الأسعار ثم أعد المحاولة.','warn');
  if(!Number.isFinite(q)||q<=0)return toast('الكمية غير صحيحة','warn');
  const f=ttCalculateFees(s.price,q);const tc=Number(f.stockValue)+Number(f.totalFees);
  if(!Number.isFinite(tc)||tc<=0)return toast('تعذّر حساب قيمة الأمر، لم يتم تنفيذ الشراء.','warn');
  if(tc>cash+1e-8)return toast('الكاش غير كافٍ','warn');
  if(!(await askConfirm(`تأكيد الشراء؟\n${displayId(s)}\nالكمية: ${fmtQty(q)}\nالإجمالي: ${fmt(tc)} TND`)))return; if(tc>cash)return toast('الرصيد لم يعد كافيًا','warn');
  const h=holdings[s.id];if(h&&(!Number.isFinite(Number(h.qty))||Number(h.qty)<0||!Number.isFinite(Number(h.avg))||Number(h.avg)<0))return toast('بيانات المركز غير سليمة؛ أوقفنا الأمر لحماية رصيدك.','warn');
  if(h){h.avg=(h.avg*h.qty+tc)/(h.qty+q);h.qty+=q;}else holdings[s.id]={qty:q,avg:tc/q};
  cash-=tc;addTrade(s.id,'buy',q,s.price);
  trackWeeklyEvent('trade');unlockBadge('first_trade');
  toast(`تم شراء ${fmtQty(q)} × ${displayId(s)}`,'good');
  ttDailyXP('buy',10,50);inputVal=buyMode==='qty'?1:50;saveState(true);renderSheet();updateHero();
  if(recentTrades.length>=10)unlockBadge('ten_trades');
}
async function _doSellCore(){
  if(!isTradingAllowed())return toast('السوق مغلق','warn');
  const s=STOCKS.find(x=>x.id===openStockId);if(!s||!Number.isFinite(Number(s.price))||Number(s.price)<=0)return toast('تعذّر التحقق من سعر السهم. لم يتم البيع.','warn');
  const h=holdings[s.id];const q=Number(currentQty());
  if(!Number.isFinite(q)||q<=0)return toast('الكمية غير صحيحة','warn');
  if(!h||!Number.isFinite(Number(h.qty))||h.qty<q-0.0001)return toast('لا تملك كمية كافية','warn');
  if(!Number.isFinite(Number(h.avg))||Number(h.avg)<0)return toast('تكلفة الشراء المسجلة غير سليمة؛ أوقفنا البيع لحماية سجلّك.','warn');
  const f=ttCalculateFees(s.price,q);const net=Number(f.stockValue)-Number(f.totalFees);
  if(!Number.isFinite(net)||net<0)return toast('تعذّر حساب صافي البيع؛ لم يتم تنفيذ الأمر.','warn');
  const profit=net-h.avg*q;
  if(!Number.isFinite(profit))return toast('تعذّر التحقق من نتيجة البيع؛ لم يتم تنفيذ الأمر.','warn');
  if(!(await askConfirm(`تأكيد البيع؟\n${displayId(s)}\nالكمية: ${fmtQty(q)}\nالمستلم: ${fmt(net)} TND`)))return;
  cash+=net;realizedPnl+=profit;h.qty-=q;
  if(h.qty<0.0001){delete holdings[s.id];pendingOrders=pendingOrders.filter(o=>!(o.type==='sl'&&o.stockId===s.id));}
  addTrade(s.id,'sell',q,s.price);
  trackWeeklyEvent('trade');
  if(profit>0){unlockBadge('first_profit');awardPnL(profit,h.avg*q);trackWeeklyEvent('winner');}else if(profit<0){awardPnL(profit,h.avg*q);}
  toast(`تم بيع ${fmtQty(q)} × ${displayId(s)}`,'warn');
  inputVal=buyMode==='qty'?1:50;saveState(true);renderSheet();updateHero();
  if(recentTrades.length>=10)unlockBadge('ten_trades');
}

/* يمنع النقر المزدوج من تنفيذ عمليتين متتاليتين قبل اكتمال الأولى. */
let _tradeActionBusy=false;
async function doBuy(){
  if(_tradeActionBusy)return toast('الأمر السابق قيد المعالجة، انتظر لحظة.','warn');
  _tradeActionBusy=true;
  try{await _doBuyCore();}finally{_tradeActionBusy=false;}
}
async function doSell(){
  if(_tradeActionBusy)return toast('الأمر السابق قيد المعالجة، انتظر لحظة.','warn');
  _tradeActionBusy=true;
  try{await _doSellCore();}finally{_tradeActionBusy=false;}
}

