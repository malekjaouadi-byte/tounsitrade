function drawCertificate(){
  const cvs=document.getElementById('certCanvas');if(!cvs)return;
  const W=900,H=640;cvs.width=W;cvs.height=H;
  const ctx=cvs.getContext('2d');
  const g=ctx.createLinearGradient(0,0,W,H);g.addColorStop(0,'#0b0e11');g.addColorStop(1,'#12161b');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='#f0b90b';ctx.lineWidth=8;ctx.strokeRect(20,20,W-40,H-40);
  ctx.strokeStyle='rgba(240,185,11,.35)';ctx.lineWidth=2;ctx.strokeRect(38,38,W-76,H-76);
  ctx.fillStyle='#E70013';ctx.fillRect(38,38,W-76,10);
  ctx.fillStyle='#f0b90b';ctx.font='bold 30px Arial';ctx.textAlign='center';
  ctx.fillText('شهادة إتمام الدروس',W/2,140);
  ctx.fillStyle='#c3cad4';ctx.font='16px Arial';
