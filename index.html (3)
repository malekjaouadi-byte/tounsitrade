async function sendContactMessage(){
  /* Client-side rate limit: protects Firestore/Formspree from accidental spam. */
  const now=Date.now();
  const lastMsg=Number(localStorage.getItem('tt_last_message_at')||0);
  const dayKey='tt_msg_day_'+new Date().toISOString().slice(0,10);
  const dayCount=Number(localStorage.getItem(dayKey)||0);
  if(now-lastMsg<60000)return toast('⏳ يمكنك إرسال رسالة أخرى بعد دقيقة','warn');
  if(dayCount>=10)return toast('⚠️ تم بلوغ الحد اليومي للرسائل','warn');
  const subject=document.getElementById('contactSubject').value;
  const name=cleanText(document.getElementById('contactName').value)||(currentUser?currentUser.name:'مجهول');
  const email=cleanText(document.getElementById('contactEmail').value,120);
  const message=document.getElementById('contactMessage').value.replace(/[<>]/g,'').trim().slice(0,2000);
  if(message.length<10)return toast('الرسالة قصيرة جدًا','warn');
  if(email&&!email.includes('@'))return toast('البريد غير صحيح','warn');
  localStorage.setItem('tt_last_message_at',String(now));
  localStorage.setItem(dayKey,String(dayCount+1));
  const btn=document.getElementById('sendMsgBtn');btn.disabled=true;btn.textContent='جاري الإرسال...';
  const msg={id:'msg_'+Date.now(),subject,subjectLabel:SUBJECT_LABELS[subject],name,email,message,sentAt:Date.now(),status:'pending'};
  sentMessages.unshift(msg);if(sentMessages.length>30)sentMessages.pop();
  saveState();
  // FIX #4: احفظ في Firestore أولاً
  try{
    if(fbDb&&currentUser){
      await fbDb.collection('messages').add({...msg,uid:currentUser.id,userName:currentUser.name});
      msg.status='sent';
    }
  }catch(e){msg.status='failed';window._fsErr=String(e&&(e.code||e.message)||'');console.error('Firestore msg:',e);}
  // إذا Formspree غير مُفعّل، اعتمد على Firestore
  if(FORMSPREE_ENDPOINT.includes('YOUR_FORM_ID')){
    if(msg.status==='sent'){
      pushNotification('contact','✅ تم استلام رسالتك','سنراجعها قريبًا.');
      toast('✅ تم الإرسال بنجاح','good');
    }else{
      pushNotification('contact','⚠️ تعذّر الإرسال','حاول لاحقًا.');
      toast('تعذّر الإرسال','warn');
    }
    btn.disabled=false;btn.textContent='إرسال';closeSheet();
    return;
  }
  // Formspree مُفعّل
  try{
    const res=await fetch(FORMSPREE_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({name,email:email||'غير محدد',subject:SUBJECT_LABELS[subject],message,_subject:`[TounsiTrade · ${SUBJECT_LABELS[subject]}] من ${name}`,userId:currentUser?currentUser.id:'anon'})});
    if(res.ok){msg.status='sent';pushNotification('contact','✅ تم إرسال رسالتك','سنراجعها ونردّ قريبًا.');toast('✅ تم الإرسال!','good');}
    else throw new Error('HTTP '+res.status);
  }catch(err){console.error('Contact:',err);setTimeout(()=>toast('سبب الفشل: '+cleanText(err&&err.message,30)+(window._fsErr?' | Firestore: '+cleanText(window._fsErr,30):''),'warn'),500);msg.status='failed';pushNotification('contact','⚠️ تعذّر الإرسال','حاول لاحقًا.');toast('تعذّر الإرسال','warn');}
  finally{btn.disabled=false;btn.textContent='إرسال';closeSheet();}
}

