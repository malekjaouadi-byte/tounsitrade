async function _flushState(force=false){
  if(!stateLoaded||!currentUser||!fbDb||!_stateDirty)return false;
  if(window._cloudOK===false){try{const _d=await fbDb.doc(stateDocPath()).get();let _local=null;try{_local=JSON.parse(localStorage.getItem('tt_bk_'+currentUser.id)||'null');}catch(_e){}const _remoteAt=_d.exists?Number((_d.data()||{}).updatedAt)||0:0;const _localAt=_local?Number(_local.updatedAt)||0:0;if(_d.exists&&(!_local||_remoteAt>=_localAt))return false;window._cloudOK=true;}catch(e){return false;}}
  // Local backup is written immediately by saveState(); cloud writes are throttled to reduce Firestore load.
  const last=Number(window._lastCloudWriteAt)||0;
  const wait=SAVE_THROTTLE_MS-(Date.now()-last);
  if(!force&&last>0&&wait>0){
    if(_flushTimer)clearTimeout(_flushTimer);
    _flushTimer=setTimeout(()=>{_flushTimer=null;_flushState(false);},wait+50);
    return false;
  }
  _stateDirty=false;
  if(_flushTimer){clearTimeout(_flushTimer);_flushTimer=null;}
  try{
    const ok=await _saveStateNow();
    if(!ok){_stateDirty=true;if(!_flushTimer)_flushTimer=setTimeout(()=>{_flushTimer=null;_flushState(false);},60000);}
    else if(_stateDirty&&!_flushTimer){_flushTimer=setTimeout(()=>{_flushTimer=null;_flushState(false);},Math.max(50,SAVE_THROTTLE_MS-(Date.now()-(Number(window._lastCloudWriteAt)||Date.now()))+50));}
    return ok;
  }catch(e){
    _stateDirty=true;
    console.error('flushState',e);
    return false;
  }
}

