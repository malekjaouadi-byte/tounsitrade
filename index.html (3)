    // الإفراط في التداول
    const n60=recentTrades.filter(x=>now-x.t<3600000).length;
    if(n60>=6){L.push({k:'warn',tag:'over',t:'🔁 نفّذت '+n60+' عمليات خلال الساعة الأخيرة؛ الرسوم تتراكم وكثرة الصفقات تضعف القرار.'});}
    // التشتت
    const syms=new Set(recentTrades.filter(x=>now-x.t<30*60000).map(x=>x.sym));
    if(!syms.has(s.id))syms.add(s.id);
    const openN=Object.keys(holdings).length+(holdings[s.id]?0:1);
    if(syms.size>=5||openN>=7){L.push({k:'warn',tag:'scatter',t:'🧩 '+(syms.size>=5?'تنقّلت بين '+syms.size+' أسهم خلال 30 دقيقة':'ستملك '+openN+' مراكز مفتوحة')+'؛ التشتت يصعّب المتابعة. هل لديك خطة لكل سهم؟'});}
    // تركّز
    if(share>40){L.push({k:'warn',t:'⚖️ بعد الشراء سيمثل '+id+' نحو '+share.toFixed(0)+'% من محفظتك — تركيز عالٍ.'});}
    // سيولة
    const left=(cash-(f.stockValue+f.totalFees))/pv*100;
    if(left<5&&left>=0){L.push({k:'warn',t:'💵 ستبقى لك سيولة '+left.toFixed(1)+'% فقط بعد هذه الصفقة.'});}
    // القيمة العادلة
    if(s.fair>0){const rel=s.price/s.fair-1;
      if(rel>0.03)L.push({k:'info',t:'📊 السعر أعلى من القيمة العادلة التقديرية بنحو '+(rel*100).toFixed(1)+'%.'});
      else if(rel<-0.03)L.push({k:'good',t:'📊 السعر أقل من القيمة العادلة التقديرية بنحو '+Math.abs(rel*100).toFixed(1)+'%.'});}
    // خبر حديث عن السهم
    try{const nw=hubNews.filter(n=>now-n.t<20*60000&&n.txt.indexOf(id)>-1)[0];if(nw)L.push({k:nw.up?'good':'warn',t:'📰 خبر حديث عن '+id+' ('+(nw.up?'إيجابي':'سلبي')+'): '+esc(nw.txt)});}catch(e){}
    // وقف الخسارة
    if(!pendingOrders.some(o=>o.type==='sl'&&o.stockId===s.id))L.push({k:'tip',t:'🛑 لا يوجد وقف خسارة لهذا السهم — يمكنك وضعه بعد الشراء إن رغبت.'});
    L.sort((a,b)=>RANK[a.k]-RANK[b.k]);
    L.filter(x=>x.tag).forEach(x=>A.count(x.tag));
    const top=L.slice(0,3);
    const worst=top.length?top[0].k:'good';
    if(!top.length||worst==='tip'||worst==='good'||worst==='info'){
      A.show({key:'pre',k:worst==='warn'||worst==='bad'?worst:'good',title:'فحص سريع قبل الشراء',lines:(top.length?top.map(x=>x.t):['✅ لا ملاحظات مقلقة على '+id+' الآن.']),ms:8000});
    }else{
      A.show({key:'pre',k:worst,title:'انتبه قبل الشراء',lines:top.map(x=>x.t),ms:11000});
    }
  };

  /* ---------- بعد كل بيع: أنماط الانتقام / البيع المبكر / الإفراط ---------- */
  A.afterSell=function(sym,qty,price,inf){
    const s=STOCKS.find(x=>x.id===sym);if(!s||!(inf.avg>0))return;
    const id=displayId(s),fees=ttCalculateFees(price,qty).totalFees;
    const pct=((price-inf.avg)*qty-fees)/(inf.avg*qty)*100,mins=inf.t0?(Date.now()-inf.t0)/60000:null;
    if(pct<=-3){
      lsS('adv_lastloss_'+mode(),{t:Date.now(),pct,id:sym});
      A.show({key:'sell',k:'info',title:'خسارة '+Math.abs(pct).toFixed(1)+'% على '+id,lines:['الخسارة جزء طبيعي من التداول. الأهم ألّا تحاول تعويضها فورًا — يمكنك مراجعة صفقتك في «دفتر صفقاتي» أولًا.']});
    }else if(pct>0){
      try{const k='adv_sold_'+mode(),L=lsG(k,[]).filter(x=>Date.now()-x.t<60*60000);L.push({t:Date.now(),id:sym,price,pct,done:false});lsS(k,L.slice(-15));}catch(e){}
    }
    A.overtrade();
  };
  A.afterBuy=function(){A.overtrade();};
  A.overtrade=function(){
    const n=recentTrades.filter(x=>Date.now()-x.t<3600000).length;
    if(n>=6&&ok('over',15*60000)){A.count('over');A.show({key:'over',k:'warn',title:'كثرة عمليات',lines:['🔁 '+n+' عمليات في ساعة واحدة. تذكّر أن كل عملية تدفع رسومًا — هل ما زالت كل صفقة ضمن خطتك؟']});}
  };

  /* ---------- المرحلة 1-ب + أنماط الإمساك بالخاسر والبيع المبكر: تنبيهات وقتية ---------- */
  A.tick=function(){
    if(!enabled()||!live())return;
    try{if(getMarketMode()==='live'&&!isMarketOpen())return;}catch(e){}
    // البيع المبكر: السهم صعد ≥4% بعد بيعه بربح
    try{
      const k='adv_sold_'+mode(),L=lsG(k,[]);let ch=false;
      for(const r of L){
        if(r.done)continue;const age=(Date.now()-r.t)/60000;if(age<4||age>45)continue;
        const s=STOCKS.find(x=>x.id===r.id);if(!s)continue;
        if(s.price>=r.price*1.04){r.done=true;ch=true;A.count('early');
          A.show({key:'early'+r.id,k:'info',title:'هل بعت مبكرًا؟',lines:['✂️ '+displayId(s)+' ارتفع '+((s.price/r.price-1)*100).toFixed(1)+'% بعد بيعك بربح. جني الربح ليس خطأ — لكن فكّر: هل كان لديك هدف سعري محدّد؟'],act:{label:'افتح السهم',fn:openStock(s.id)}});
          break;}
      }
      if(ch)lsS(k,L);
    }catch(e){}
    // مراكز مفتوحة
    for(const [id,h] of Object.entries(holdings)){
      const s=STOCKS.find(x=>x.id===id);if(!s||!(h.qty>0)||!(h.avg>0))continue;
      const nm=displayId(s),pct=(s.price/h.avg-1)*100,held=h.t0?(Date.now()-h.t0)/60000:30;
      const sl=pendingOrders.some(o=>o.type==='sl'&&o.stockId===id);
      if(pct<=-8&&held>=15&&ok('loser_'+id,25*60000)){A.count('holdloser');
        A.show({key:'hold'+id,k:'bad',title:'مركز خاسر منذ مدة',lines:['⚓ '+nm+' خسارته '+Math.abs(pct).toFixed(1)+'% منذ ~'+Math.round(held)+' د. هل ما زالت فكرتك الأصلية صالحة، أم تنتظر عودة السعر فقط؟'],act:{label:'افتح السهم',fn:openStock(id)}});return;}
      if(pct<=-5&&!sl&&ok('nosl_'+id,20*60000)){
        A.show({key:'hold'+id,k:'warn',title:'بدون وقف خسارة',lines:['🛑 '+nm+' خسر '+Math.abs(pct).toFixed(1)+'% ولا يوجد وقف خسارة. يمكنك تحديد حدّ أقصى للخسارة مسبقًا.'],act:{label:'ضع وقف خسارة',fn:openStock(id)}});return;}
      if(pct>=12&&ok('gain_'+id,30*60000)){
        A.show({key:'hold'+id,k:'good',title:'ربح جيد على '+nm,lines:['🟢 ربحك '+pct.toFixed(1)+'%. من الخيارات: جني جزء منه أو رفع وقف الخسارة لحماية الربح — والقرار لك.'],act:{label:'افتح السهم',fn:openStock(id)}});return;}
      if(s.chg<=-4&&ok('drop_'+id,30*60000)){
        A.show({key:'hold'+id,k:'warn',title:nm+' يهبط اليوم',lines:['📉 السهم منخفض '+Math.abs(s.chg).toFixed(1)+'% اليوم وأنت تملكه. راجع الأخبار وخطتك قبل أي تصرف.'],act:{label:'افتح السهم',fn:openStock(id)}});return;}
    }
  };

  /* ---------- المرحلة 1-ج: ربط الأخبار بالأسهم المملوكة ---------- */
  A.onNews=function(title,body){
    if(!enabled()||!live())return;
    const s=Object.keys(holdings).map(id=>STOCKS.find(x=>x.id===id)).filter(Boolean).find(z=>String(title).indexOf(displayId(z))>-1);
    if(!s)return;
    const up=hubNews[0]&&hubNews[0].txt===body?hubNews[0].up:null;
    A.show({key:'news'+s.id,k:up===false?'warn':(up===true?'good':'info'),title:'خبر يخص سهمًا تملكه',lines:['📰 '+esc(body),'قد يتحرك السعر على المدى القصير؛ راجع هدفك ووقف خسارتك قبل أي قرار.'],act:{label:'افتح السهم',fn:openStock(s.id)},ms:11000});
  };

  /* ---------- الربط بالتطبيق دون المساس بمنطقه ---------- */
  const _db=doBuy;
  doBuy=async function(){try{if(isTradingAllowed())A.preBuy();}catch(e){}return _db.apply(this,arguments);};
  const _at=addTrade;
  addTrade=function(sym,side,qty,price){
    let inf=null;
    try{if(side==='sell'){const h=holdings[sym],j=window._jr&&window._jr[sym];const b=h||j;if(b)inf={avg:b.avg,t0:b.t0||(j&&j.t0)};}}catch(e){}
    const r=_at.apply(this,arguments);
    try{if(side==='sell'&&inf&&inf.avg>0)A.afterSell(sym,qty,price,inf);else if(side==='buy')A.afterBuy();}catch(e){}
    return r;
  };
  const _pn=pushNotification;
  pushNotification=function(type,title,body){
    const r=_pn.apply(this,arguments);
    try{if(type==='news')A.onNews(title,body);}catch(e){}
    return r;
  };
  setInterval(()=>{try{A.tick();}catch(e){}},20000);

  /* ---------- مركز المرشد (من «المزيد») ---------- */
  A.toggle=function(){try{localStorage.setItem('tt_adv_on',enabled()?'0':'1');}catch(e){}A.openHub();};
  A.openHub=function(){
    const on=enabled(),st=lsG('adv_stats_'+mode(),{}),log=lsG('adv_log_'+mode(),[]);
    const top=Object.entries(st).sort((a,b)=>b[1]-a[1])[0];
    const STAGES=[
      ['التنبيهات اللحظية','فحص فوري قبل كل شراء، تنبيهات وقتية أثناء الاحتفاظ، وربط الأخبار بالأسهم المملوكة.',1],
      ['كشف الأنماط السلوكية','ستة أنماط: الانتقام من السوق، الإفراط في التداول، FOMO، الإمساك بالخاسر، البيع المبكر، التشتت.',1],
      ['تقارير دورية','تقارير يومية وأسبوعية وشهرية عن أدائك وسلوكك.',0],
      ['التحليل الفني الآلي','يفسّر الشارتات ويقترح فرصًا للتعلّم.',0],
      ['مساعد تفاعلي','ست أسئلة جاهزة تسألها للمرشد عن محفظتك.',0],
      ['تخطيط مالي شخصي','أهداف أسبوعية مخصصة لك.',0],
      ['تحليل «ماذا لو»','يقارن ما حدث فعلًا بما كان يمكن أن يحدث.',0],
      ['نمط المتداول (Trader DNA)','بصمتك الشخصية بعد 20 صفقة.',0],
      ['مسار تعليمي مخصص','يقترح الدروس حسب حاجتك اللحظية.',0],
      ['الطبقة الأخلاقية','Cool-down بعد الخسارات الكبيرة وسقف يومي اختياري.',0]
    ];
    const ago=t=>{const m=Math.round((Date.now()-t)/60000);return m<1?'الآن':m<60?'قبل '+m+' د':'قبل '+Math.round(m/60)+' س';};
    sheetBody.innerHTML=`<div class="sh-head"><div style="display:flex;align-items:center;gap:12px"><div style="width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,rgba(240,185,11,.25),rgba(240,185,11,.05));border:1px solid rgba(240,185,11,.4);display:grid;place-items:center;font-size:24px">🧠</div><div><div style="font-size:16px;font-weight:900">المرشد الذكي</div><div style="font-size:11px;color:#7b8494;margin-top:2px">يقترح ويحذّر ويعلّم — ولا يقرّر عنك</div></div></div></div>
    <div class="advh-box" style="display:flex;align-items:center;justify-content:space-between;gap:10px"><div><div class="advh-t" style="margin:0">إظهار رسائل المرشد</div><div style="font-size:10px;color:#7b8494;margin-top:3px;line-height:1.6">تظهر كرسالة جانبية في الأعلى: تقرؤها أو تتجاهلها، والأزرار تبقى فعّالة دائمًا.</div></div><button class="priv-toggle ${on?'':'off'}" onclick="ttAdv.toggle()"><span class="knob"></span></button></div>
    <div class="advh-box"><div class="advh-t">🧭 أنماطك السلوكية (${mode()==='live'?'وضع السوق':'وضع التدريب'})</div><div class="advh-pat">${Object.entries(PATTERNS).map(([k,v])=>`<div><b>${st[k]||0}</b><span>${v[0]} ${v[1]}</span></div>`).join('')}</div>${top?`<div style="font-size:11px;color:#c7ced9;margin-top:9px;line-height:1.7">🎯 أكثر نمط ظهر معك: <b style="color:#f0b90b">${PATTERNS[top[0]][1]}</b> (${top[1]} مرة)</div>`:'<div style="font-size:11px;color:#7b8494;margin-top:9px;line-height:1.7">لا أنماط مرصودة بعد. تابع التداول وسيراقب المرشد سلوكك بهدوء.</div>'}</div>
    <div class="advh-box"><div class="advh-t">🗺️ خارطة توسيع المرشد (10 مراحل)</div>${STAGES.map((s,i)=>`<div class="advh-st ${s[2]?'on':''}"><div class="advh-n">${i+1}</div><div style="flex:1"><b>${s[0]}</b><span class="advh-chip">${s[2]?'✅ نشطة':'⏳ قادمة'}</span><p>${s[1]}</p></div></div>`).join('')}</div>
    <div class="advh-box"><div class="advh-t">📝 الترتيب التنفيذي</div><div style="font-size:11.5px;line-height:1.95;color:#c7ced9">يتوسّع دور المرشد الذكي عبر عشر مراحل متدرّجة تبدأ بالأولوية القصوى: <b>التنبيهات اللحظية</b> (تحقق فوري قبل كل شراء، تنبيهات وقتية أثناء الاحتفاظ، ربط الأخبار بالأسهم المملوكة)، ثم <b>كشف الأنماط السلوكية الستة</b> (الانتقام من السوق، الإفراط في التداول، FOMO، الإمساك بالخاسر، البيع المبكر، التشتت)، ثم <b>تقارير دورية</b> (يومية وأسبوعية وشهرية) مع <b>تحليل فني آلي</b> يفسّر الشارتات ويقترح فرصًا، ثم <b>مساعد تفاعلي</b> بست أسئلة جاهزة، فـ<b>تخطيط مالي شخصي</b> بأهداف أسبوعية، فـ<b>تحليل عكسي «ماذا لو»</b> يقارن ما حدث بما كان يمكن أن يحدث، فـ<b>نمط المتداول الشخصي (Trader DNA)</b> بعد 20 صفقة، فـ<b>مسار تعليمي مخصص</b> يقترح الدروس حسب الحاجة اللحظية، وينتهي بـ<b>طبقة أخلاقية</b> تفرض Cool-down بعد الخسارات الكبيرة وسقفًا يوميًا اختياريًا — والترتيب التنفيذي واضح: نبدأ بالمرحلتين الأوليين فقط (التنبيهات + الأنماط السلوكية) لما لهما من أثر تعليمي عالٍ وجهد برمجي منخفض، ثم نوسّع تدريجيًا بعد جمع ملاحظات 20 مستخدمًا حقيقيًا، مع الحفاظ على المبدأ الجوهري: <b style="color:#f0b90b">المرشد يقترح ويحذّر ويعلّم، لكنه لا يقرّر نيابة عن المستخدم أبدًا.</b></div></div>
    <div class="advh-box"><div class="advh-t">🕘 آخر رسائل المرشد</div>${log.length?log.slice(0,8).map(l=>`<div class="advh-log">${ICON[l.k]||'🧠'} <b>${esc(l.title)}</b> <small>${ago(l.t)}</small><br>${esc(l.line)}</div>`).join(''):'<div style="font-size:11px;color:#7b8494">لا رسائل بعد.</div>'}</div>
    <div class="disc">تحليل آلي تعليمي لبياناتك التجريبية — ليس نصيحة استثمارية.</div>`;
    sheet.classList.add('on');backdrop.classList.add('on');
  };
  return A;
})();
function openAdvisorHub(){ttAdv.openHub();}
</script>

<script>
/* ===== TounsiTrade content & fairness update ===== */
(function(){
/* ---------- 1) New lessons ---------- */
const APP={cat:'app',catName:'مزايا المنصة',catIcon:'🧭'};
LESSONS.push(
Object.assign({},APP,{id:'d1',icon:'💰',title:'توزيعات الأرباح وقطع الكوبون',time:'6 د',content:`<p><b>توزيع الأرباح</b> جزء من أرباح الشركة يُدفع للمساهمين. ولتستحقه يجب أن تملك السهم <b>قبل تاريخ قطع الكوبون</b>.</p><p><b>🔢 مثال:</b> تملك 200 سهم والتوزيع 0.5 د.ت للسهم → تستلم 100 د.ت. وفي يوم القطع ينخفض سعر السهم تقريبًا بقيمة التوزيع، لأن جزءًا من قيمة الشركة خرج إلى المساهمين.</p><p><b>⚠️ خطأ شائع:</b> شراء السهم قبل القطع بنية «ربح مضمون». السعر ينخفض بعد القطع، فالتوزيع ليس مالًا مجانيًا.</p><p><b>🛠️ في المنصة:</b> افتح «التقويم» من الصفحة الرئيسية لترى الأحداث. الزمن في المحاكاة مضغوط.</p><p><b>✅ الخلاصة:</b> التوزيع جزء من العائد الكلي ولا يلغي مخاطرة السعر.</p>`}),
Object.assign({},APP,{id:'d2',icon:'🔀',title:'الأسهم المجانية والتجزئة',time:'6 د',content:`<p><b>الأسهم المجانية</b> و<b>التجزئة</b> تغيّران عدد أسهمك وسعر السهم، لا قيمة استثمارك الكلية.</p><p><b>🔢 مثال التجزئة:</b> 100 سهم × 10 د.ت = 1,000. بعد تجزئة 1→2: 200 سهم × 5 د.ت = 1,000، ويتعدّل متوسط تكلفتك إلى النصف.</p><p><b>🎁 الأسهم المجانية:</b> سهم جديد لكل 10 أسهم: تملك 110 بدل 100 والسعر يتعدّل بما يعادل ذلك، فالقيمة الكلية ثابتة نظريًا.</p><p><b>⚠️ خطأ شائع:</b> اعتبار السعر الأرخص بعد التجزئة «فرصة». الشركة هي نفسها.</p><p><b>🛠️ في المنصة:</b> تُلغى أوامرك المعلّقة على السهم عند التعديل ويُعاد المبلغ المحجوز، فأعد وضعها بالسعر الجديد.</p>`}),
Object.assign({},APP,{id:'d3',icon:'⏱️',title:'ما قبل الافتتاح وأنواع الأوامر',time:'7 د',content:`<p>مرحلة <b>08:30 – 09:00</b> تُدخل فيها الأوامر أو تعدّلها أو تلغيها، لكنها <b>لا تُنفَّذ فورًا</b>؛ تُقابَل عند الافتتاح حسب السعر والأولوية الزمنية.</p><p><b>🎯 أنواع الأوامر في المنصة:</b></p><ul><li><b>شراء/بيع فوري:</b> بسعر السوق وقت التنفيذ.</li><li><b>شراء عند سعر:</b> ينتظر وصول السعر، ويُحجز المبلغ مسبقًا ويُعاد عند الإلغاء.</li><li><b>وقف الخسارة:</b> يبيع مركزك إذا نزل السعر إلى حدّك.</li><li><b>منبّه:</b> يخبرك فقط ولا ينفّذ شيئًا.</li></ul><p><b>⚠️ تنبيه:</b> وقف الخسارة لا يضمن البيع بالسعر المحدد تمامًا إذا تحرك السعر بسرعة.</p><p><b>✅ الخلاصة:</b> اختر نوع الأمر حسب هدفك: تنفيذ، أو سعر، أو حماية.</p>`}),
Object.assign({},APP,{id:'d4',icon:'📓',title:'دفتر الصفقات: تعلّم من أخطائك',time:'6 د',content:`<p>«دفتر صفقاتي» يسجّل كل صفقة بعد بيعها ويحلّل أسباب الربح أو الخسارة.</p><p><b>🔍 ماذا تراجع؟</b></p><ul><li>نسبة النجاح ومتوسط الربح ومتوسط الخسارة</li><li>نقطة الضعف الأكثر تكرارًا</li><li>أثر الرسوم ومدة الاحتفاظ وحجم المركز</li></ul><p><b>🔢 مثال:</b> نسبة نجاح 40% لا تعني فشلًا إذا كان متوسط الربح ضعف متوسط الخسارة.</p><p><b>🛠️ عادة أسبوعية:</b> افتح الدفتر، اختر أسوأ صفقة، واكتب قاعدة واحدة تمنع تكرارها.</p><p><b>✅ الخلاصة:</b> من لا يسجّل أخطاءه يكررها.</p>`}),
Object.assign({},APP,{id:'d5',icon:'📐',title:'حجم المركز: كم تشتري؟',time:'7 د',content:`<p>السؤال ليس «ماذا أشتري؟» فقط، بل <b>«كم أشتري؟»</b>.</p><p><b>📐 الصيغة:</b> عدد الأسهم = (رأس المال × نسبة المخاطرة) ÷ (سعر الدخول − سعر الوقف).</p><p><b>🔢 مثال (قبل الرسوم):</b> رأس المال 10,000 ونسبة المخاطرة 2% = 200 د.ت. دخول 50 ووقف 47 → خسارة السهم 3. عدد الأسهم = 200 ÷ 3 ≈ 66 سهمًا، أي مركز بنحو 3,300 د.ت.</p><p><b>⚠️ انتبه:</b> قد يكون المركز كبيرًا (33% من المحفظة) رغم أن المخاطرة 2%. راقب التركّز أيضًا.</p><p><b>✅ الخلاصة:</b> حدّد خسارتك المقبولة أولًا، ثم احسب الكمية.</p>`}),
Object.assign({},APP,{id:'d6',icon:'🧠',title:'أنماط السلوك التي يرصدها المرشد',time:'6 د',content:`<p>يرصد المرشد الذكي ستة أنماط سلوكية شائعة:</p><ul><li>😤 <b>الانتقام من السوق:</b> شراء سريع لتعويض خسارة.</li><li>🔁 <b>الإفراط في التداول:</b> عمليات كثيرة ورسوم متراكمة.</li><li>🏃 <b>FOMO:</b> الشراء خوفًا من الفوات بعد صعود حاد.</li><li>⚓ <b>الإمساك بالخاسر:</b> انتظار عودة السعر دون سبب.</li><li>✂️ <b>البيع المبكر:</b> جني ربح صغير ثم ارتفاع كبير.</li><li>🧩 <b>التشتت:</b> التنقل بين أسهم كثيرة بلا خطة.</li></ul><p><b>💡 مهم:</b> هذه تنبيهات تعليمية ولا تعني أنك مخطئ. تجاهلها إن كانت خطتك واضحة.</p><p><b>🛠️ طبّق:</b> افتح «مركز المرشد الذكي» من «المزيد» وانظر أكثر نمط يتكرر معك.</p>`}),
{cat:'tn',catName:'السوق التونسي',catIcon:'🇹🇳',id:'tn4',icon:'🧾',title:'قبل أن تتداول فعليًا',time:'6 د',content:`<p>التطبيق محاكاة تعليمية؛ أما التداول الفعلي فيتم عبر <b>وسيط مرخّص</b> لدى هيئة السوق المالية.</p><p><b>✅ قبل أن تبدأ فعليًا:</b></p><ul><li>تأكد من ترخيص الوسيط لدى الجهات الرسمية.</li><li>اطلب جدول العمولات والرسوم كتابةً.</li><li>اسأل عن شروط فتح الحساب وطرق إيداع الأموال وسحبها.</li><li>اسأل عن الضرائب المطبقة على التوزيعات والأرباح، وراجع النصوص الرسمية أو مختصًا.</li><li>ابدأ بمبلغ تقبل خسارته.</li></ul><p><b>⚠️ تنبيه:</b> أسعار هذا التطبيق وأسماء شركاته افتراضية، ونتائجك فيه لا تتنبأ بنتائجك الحقيقية.</p>`}
);
