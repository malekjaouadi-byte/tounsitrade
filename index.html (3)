<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,user-scalable=yes">
<meta name="theme-color" content="#0b0e11"><link rel="apple-touch-icon" href="data:image/jpeg;base64,"><meta name="mobile-web-app-capable" content="yes">
<meta name="description" content="TounsiTrade: محاكي تعليمي للتداول في البورصة التونسية برصيد افتراضي ودروس عربية مبسّطة.">
<title>TounsiTrade — محاكي التداول التونسي</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,"Segoe UI",Tahoma,system-ui,sans-serif;background:#05070a;color:#eaecef;display:flex;justify-content:center;min-height:100vh;overflow-x:hidden}
.app{width:100%;max-width:460px;height:100vh;height:100vh;height:-webkit-fill-available;height:100dvh;display:flex;flex-direction:column;background:#0b0e11;position:relative;overflow:hidden}
#splash{position:fixed;top:0;right:0;bottom:0;left:0;background:#0b0e11;z-index:999;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .6s ease,visibility .6s}
#splash.hide{opacity:0;visibility:hidden}
.splash-logo{width:110px;height:110px;border-radius:28px;background:linear-gradient(135deg,#e70013,#8b0010);display:grid;place-items:center;box-shadow:0 15px 60px rgba(231,0,19,.5);animation:logoPulse 2s ease-in-out infinite}
.splash-logo svg{width:100%;height:100%}
@keyframes logoPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}
.splash-title{font-size:28px;font-weight:800;letter-spacing:-.5px;margin-top:24px;background:linear-gradient(90deg,#fff,#f0b90b);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.splash-tag{font-size:13px;color:#7b8494;margin-top:8px}
.splash-quote{font-size:11px;color:#8b95a5;margin-top:14px;text-align:center;max-width:280px;line-height:1.75;font-style:italic;padding:0 20px;opacity:.9}
.splash-quote::before{content:"«";color:#f0b90b;font-weight:900;margin-left:2px}
.splash-quote::after{content:"»";color:#f0b90b;font-weight:900;margin-right:2px}
.zellige-bg{position:absolute;top:0;right:0;bottom:0;left:0;z-index:0;pointer-events:none;overflow:hidden;opacity:.06}
.zellige-bg svg{position:absolute;top:50%;left:50%;width:200%;height:200%;transform:translate(-50%,-50%);animation:zelligeRotate 60s linear infinite}
@keyframes zelligeRotate{from{transform:translate(-50%,-50%) rotate(0deg)}to{transform:translate(-50%,-50%) rotate(360deg)}}
.auth-screen{position:fixed;top:0;right:0;bottom:0;left:0;background:#0b0e11;z-index:800;display:flex;flex-direction:column;padding:0;overflow-y:auto;overflow-x:hidden}
.auth-screen.hide{display:none}
.auth-content{position:relative;z-index:2;display:flex;flex-direction:column;padding:40px 24px 30px;min-height:100%}
.auth-logo-wrap{display:flex;flex-direction:column;align-items:center;margin-top:4vh;margin-bottom:24px;position:relative}
.auth-logo{width:130px;height:130px;border-radius:32px;background:linear-gradient(135deg,#e70013,#8b0010);display:grid;place-items:center;animation:logoGlow 3s ease-in-out infinite}
.auth-logo svg{width:100%;height:100%}
@keyframes logoGlow{0%,100%{box-shadow:0 12px 45px rgba(231,0,19,.45)}50%{box-shadow:0 12px 55px rgba(231,0,19,.65)}}
.auth-title{font-size:32px;font-weight:900;letter-spacing:-1px;margin-top:22px;color:#fff}
.auth-title .gold{background:linear-gradient(90deg,#f0b90b,#ffd94a);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.auth-tag{font-size:13.5px;color:#8b95a5;margin-top:8px;text-align:center;font-weight:600}
.auth-moto{font-size:11px;color:#7b8494;margin-top:6px;text-align:center;letter-spacing:.5px}
.auth-moto b{color:#f0b90b;font-weight:700}
.auth-quote{font-size:10.5px;color:#8b95a5;margin-top:14px;text-align:center;line-height:1.75;font-style:italic;padding:10px 16px;background:rgba(240,185,11,.04);border:1px solid rgba(240,185,11,.15);border-radius:10px;max-width:340px;margin-left:auto;margin-right:auto;position:relative}
.auth-quote::before{content:"«";color:#f0b90b;font-weight:900;font-size:13px;margin-left:2px}
.auth-quote::after{content:"»";color:#f0b90b;font-weight:900;font-size:13px;margin-right:2px}
.stats-card{display:flex;justify-content:space-around;background:linear-gradient(135deg,#12161b,#0e1216);border:1px solid #232a31;border-radius:16px;padding:16px 10px;margin:22px 0 18px}
.stats-card .stat-item{flex:1;text-align:center;padding:0 4px}
.stats-card .stat-num{font-size:19px;font-weight:900;color:#f0b90b;font-variant-numeric:tabular-nums;display:block}
.stats-card .stat-lbl{font-size:10.5px;color:#7b8494;margin-top:5px;display:block;font-weight:600}
.stats-card .divider{width:1px;background:#1c222a;margin:0 4px}
.btn-start{width:100%;padding:18px;border-radius:16px;border:none;background:linear-gradient(135deg,#f0b90b,#b88700);color:#0b0e11;font-size:16px;font-weight:900;font-family:inherit;cursor:pointer;box-shadow:0 8px 25px rgba(240,185,11,.35);transition:.15s;margin-bottom:18px;display:flex;align-items:center;justify-content:center;gap:10px;letter-spacing:.3px}
.btn-start:active{transform:scale(.97)}
.btn-start .arrow{font-size:20px}
.auth-form{width:100%}
.auth-label{font-size:11.5px;font-weight:700;color:#8b95a5;margin-bottom:7px;display:block}
.auth-input{width:100%;height:48px;background:#12161b;border:1px solid #262b30;border-radius:13px;color:#fff;font-size:14px;font-weight:600;font-family:inherit;padding:0 15px}
.auth-input:focus{outline:none;border-color:#f0b90b}
.auth-field{margin-bottom:14px}
.name-choice{display:flex;gap:8px;margin-bottom:12px}
.name-choice button{flex:1;padding:11px;border-radius:11px;border:1px solid #262b30;background:#12161b;color:#8b95a5;font-size:12px;font-weight:700;font-family:inherit;cursor:pointer}
.name-choice button.on{background:rgba(240,185,11,.14);border-color:rgba(240,185,11,.5);color:#f0b90b}
.btn-primary{width:100%;padding:15px;border-radius:14px;border:none;background:linear-gradient(135deg,#e70013,#8b0010);color:#fff;font-size:14px;font-weight:800;font-family:inherit;cursor:pointer;box-shadow:0 6px 20px rgba(231,0,19,.35);transition:.15s}
.btn-primary:active{transform:scale(.97)}
.btn-primary:disabled{opacity:.5;cursor:not-allowed}
.btn-secondary{width:100%;padding:14px;border-radius:13px;border:1.5px solid #262b30;background:#12161b;color:#eaecef;font-size:13px;font-weight:700;font-family:inherit;cursor:pointer;margin-top:9px}
.btn-social{width:100%;padding:16px;border-radius:14px;border:1.5px solid;color:#fff;font-size:14px;font-weight:800;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:11px;position:relative;transition:.15s}
.btn-social:active{transform:scale(.97)}
.btn-social.loading{opacity:.7;pointer-events:none}
.btn-social.loading .label{opacity:0}
.btn-social .spinner{position:absolute;width:20px;height:20px;border:2.5px solid rgba(255,255,255,.2);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite;display:none}
.btn-social.loading .spinner{display:block}
.btn-social svg{width:22px;height:22px;flex-shrink:0}
.btn-social.gg{background:#fff;color:#1f2328;border-color:#fff}
.btn-social.em-outline{background:transparent;border-color:#2e3742;color:#eaecef}
.edu-note{display:flex;gap:10px;align-items:flex-start;background:rgba(14,203,129,.06);border:1px solid rgba(14,203,129,.2);border-radius:12px;padding:12px 14px;margin:18px 0}
.edu-note .ico{font-size:18px;flex-shrink:0;line-height:1.3}
.edu-note .txt{font-size:11.5px;line-height:1.65;color:#8b95a5}
.edu-note .txt b{color:#0ecb81;font-weight:800}
.auth-divider{display:flex;align-items:center;gap:12px;margin:16px 0;color:#5e6673;font-size:10.5px}
.auth-divider::before,.auth-divider::after{content:"";flex:1;height:1px;background:#1c2128}
.auth-footer{margin-top:auto;padding-top:24px;text-align:center}
.auth-footer .made-in{font-size:11.5px;font-weight:700;color:#8b95a5;display:flex;align-items:center;justify-content:center;gap:6px}
.auth-footer .legal{font-size:9.5px;color:#4d545e;line-height:1.7;margin-top:8px}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 10px;flex-shrink:0;gap:10px}
.brand{display:flex;align-items:center;gap:10px;cursor:pointer;flex:1;min-width:0}
.logo{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#e70013,#8b0010);display:grid;place-items:center;position:relative;flex-shrink:0;overflow:hidden}
.logo svg{width:100%;height:100%}
.brand-name{font-size:15px;font-weight:800;letter-spacing:-.3px}
.brand-sub{font-size:10px;color:#5e6673;margin-top:1px;display:flex;align-items:center;gap:5px}
.brand-sub .mini-dot{width:5px;height:5px;border-radius:50%;background:#0ecb81}
.brand-sub #onlineCounter{color:#0ecb81;font-weight:700}
.top-actions{display:flex;gap:8px}
.icon-btn{width:38px;height:38px;border-radius:11px;background:#161a1e;border:1px solid #262b30;color:#eaecef;font-size:17px;cursor:pointer;display:grid;place-items:center;position:relative}
.icon-btn.shake{animation:shakeBell .5s ease-in-out 3}
.bell-badge{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;background:#f6465d;color:#fff;font-size:10px;font-weight:800;border-radius:9px;display:grid;place-items:center;padding:0 4px;border:2px solid #0b0e11}
@keyframes shakeBell{0%,100%{transform:rotate(0)}25%{transform:rotate(-15deg)}75%{transform:rotate(15deg)}}
.users-strip{display:flex;align-items:center;justify-content:center;gap:7px;margin:0 16px 8px;padding:6px 12px;border-radius:20px;background:rgba(14,203,129,.08);border:1px solid rgba(14,203,129,.2);font-size:10.5px;font-weight:700;color:#0ecb81}
.users-strip .dot{width:6px;height:6px;border-radius:50%;background:#0ecb81;animation:pulseDot 1.4s infinite}
@keyframes pulseDot{0%,100%{opacity:1}50%{opacity:.4}}
.market-status{display:flex;align-items:center;justify-content:space-between;margin:0 16px 10px;padding:10px 14px;border-radius:14px;font-size:11px;font-weight:800;gap:8px;transition:.3s;cursor:pointer;user-select:none}
.market-status:active{transform:scale(.98)}
.market-status.live{background:linear-gradient(135deg,rgba(246,70,93,.15),rgba(246,70,93,.05));border:1px solid rgba(246,70,93,.4);color:#f6465d}
.market-status.practice{background:linear-gradient(135deg,rgba(14,203,129,.15),rgba(14,203,129,.05));border:1px solid rgba(14,203,129,.4);color:#0ecb81}
.market-status .ms-label{display:flex;align-items:center;gap:7px}
.market-status .ms-timer{font-variant-numeric:tabular-nums;opacity:.85;font-size:10.5px}
.market-status .ms-pulse{width:7px;height:7px;border-radius:50%;animation:pulseDot 1.4s infinite}
.market-status.live .ms-pulse{background:#f6465d;box-shadow:0 0 8px #f6465d}
.market-status.practice .ms-pulse{background:#0ecb81;box-shadow:0 0 8px #0ecb81}
.market-status .ms-switch{font-size:9px;font-weight:800;background:rgba(255,255,255,.15);padding:3px 8px;border-radius:6px;margin-right:6px}
.hero{margin:0 16px 12px;padding:16px 18px;border-radius:18px;background:linear-gradient(135deg,#1a1f26,#12161b);border:1px solid #232a31;position:relative;overflow:hidden;flex-shrink:0}
.hero::after{content:"";position:absolute;top:-50px;left:-40px;width:150px;height:150px;background:radial-gradient(circle,rgba(240,185,11,.16),transparent 70%);pointer-events:none}
.hero-rank{margin-top:10px;font-size:12px;color:#f0b90b;font-weight:800;cursor:pointer;line-height:1.5}
.hero-links{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.hero-links button{padding:8px 13px;border:1px solid #2a323b;border-radius:10px;background:#1c222a;color:#eaecef;font-weight:700;font-size:11.5px;font-family:inherit;cursor:pointer}
.more-group{font-size:11px;font-weight:800;color:#7b8494;margin:16px 4px 8px;letter-spacing:.2px}
.hero-top{display:flex;justify-content:space-between;align-items:flex-start}
.hero-l{font-size:11px;color:#7b8494;margin-bottom:5px}
.hero-v{font-size:29px;font-weight:800;letter-spacing:-1px;font-variant-numeric:tabular-nums}
.hero-v span{font-size:14px;font-weight:600;color:#7b8494;margin-right:4px}
.hero-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#f0b90b,#b88700);display:grid;place-items:center;font-size:16px;font-weight:900;color:#0b0e11;cursor:pointer;flex-shrink:0;border:2px solid #232a31;position:relative;overflow:hidden;z-index:10}
.hero-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.hero-avatar .online-badge{position:absolute;bottom:-1px;right:-1px;width:11px;height:11px;border-radius:50%;background:#0ecb81;border:2px solid #0b0e11}
.hero-row{display:flex;gap:8px;margin-top:11px;flex-wrap:wrap}
.pill{font-size:11px;font-weight:700;padding:4px 9px;border-radius:8px;background:rgba(14,203,129,.12);color:#0ecb81;font-variant-numeric:tabular-nums}
.pill.dn{background:rgba(246,70,93,.12);color:#f6465d}
.pill.nu{background:#1c222a;color:#8b95a5}
.pill.warn{background:rgba(240,185,11,.15);color:#f0b90b}
.tabs{display:flex;gap:4px;margin:0 16px 10px;background:#12161b;padding:5px;border-radius:13px;border:1px solid #1e242b;flex-shrink:0}
.tab{flex:1;text-align:center;padding:9px 2px;border-radius:9px;font-size:10.5px;font-weight:700;color:#7b8494;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;transition:.15s}
.tab .ticon{font-size:16px;line-height:1}
.tab.on{background:#1e252d;color:#fff}
.sk-row{display:flex;align-items:center;gap:10px;padding:11px 4px}
.sk-c,.sk-l{background:linear-gradient(90deg,#161b21 25%,#1f262e 37%,#161b21 63%);background-size:400% 100%;animation:skShim 1.3s ease infinite}
.sk-c{width:34px;height:34px;border-radius:50%;flex-shrink:0}
.sk-l{height:11px;border-radius:6px}
@keyframes skShim{0%{background-position:100% 50%}100%{background-position:0 50%}}
main{flex:1;overflow-y:auto;padding:0 16px 28px;scrollbar-width:none}
main::-webkit-scrollbar{display:none}
.index-strip{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#12161b,#0e1216);border:1px solid #1e242b;border-radius:13px;padding:12px 14px;margin-bottom:12px}
.index-strip .nm{font-size:11px;color:#7b8494}
.index-strip .vv{font-size:16px;font-weight:800;font-variant-numeric:tabular-nums;margin-top:2px}
.sec{display:flex;align-items:center;gap:8px;margin:14px 0 9px}
.sec-t{font-size:12px;font-weight:700;color:#c3cad4}
.sec-line{flex:1;height:1px;background:#1c2128}
.badge-real,.badge-spon{font-size:9px;font-weight:700;padding:2px 7px;border-radius:5px}
.badge-real{background:#1c222a;color:#7b8494}
.badge-spon{background:rgba(240,185,11,.14);color:#f0b90b}
.info-card{background:linear-gradient(135deg,#12161b,#0e1216);border:1px solid #1c222a;border-radius:14px;padding:14px 16px;margin-bottom:10px}
.info-card.legal{border-color:rgba(231,0,19,.4);background:linear-gradient(135deg,rgba(231,0,19,.05),#0e1216)}
.info-card .ic-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.info-card .ic-icon{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#1e252d,#161b21);display:grid;place-items:center;font-size:18px;flex-shrink:0}
.info-card.legal .ic-icon{background:linear-gradient(135deg,rgba(231,0,19,.15),rgba(231,0,19,.05))}
.info-card .ic-title{font-size:13px;font-weight:800;color:#eaecef}
.info-card .ic-body{font-size:11.5px;color:#8b95a5;line-height:1.7}
.info-card .ic-body b{color:#f0b90b;font-weight:800}
.info-card.legal .ic-body b{color:#f6465d}
.fee-table{background:#0e1216;border:1px solid #1c222a;border-radius:12px;overflow:hidden;margin-top:10px}
.fee-table .ft-row{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid #161b21;font-size:11.5px}
.fee-table .ft-row:last-child{border-bottom:none}
.fee-table .ft-label{color:#8b95a5}
.fee-table .ft-value{color:#eaecef;font-variant-numeric:tabular-nums;font-weight:700}
.disc{font-size:9.5px;color:#4d545e;line-height:1.7;text-align:center;margin:18px 6px 0;padding-top:14px;border-top:1px solid #161b21}
.backdrop{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(0,0,0,.75);opacity:0;pointer-events:none;transition:.22s;z-index:40}
.backdrop.on{opacity:1;pointer-events:auto}
.sheet{position:absolute;left:0;right:0;bottom:0;z-index:50;background:#12161b;border-radius:22px 22px 0 0;border-top:1px solid #232a31;transform:translateY(101%);transition:transform .3s cubic-bezier(.3,.9,.3,1);max-height:94%;display:flex;flex-direction:column}
.sheet.on{transform:translateY(0)}
.grab{width:38px;height:4px;background:#333b45;border-radius:3px;margin:9px auto 4px}
.sheet-body{padding:8px 18px 22px;overflow-y:auto}
.sh-head{display:flex;justify-content:space-between;margin-bottom:2px}
.sh-tk{font-size:18px;font-weight:800;display:flex;align-items:center;gap:8px}
.sh-tk .ico{font-size:22px}
.sh-nm{font-size:11px;color:#6b7480;margin-top:3px}
.sh-close{width:30px;height:30px;border-radius:50%;background:#1c222a;border:none;color:#8b95a5;font-size:17px;cursor:pointer;display:grid;place-items:center}
.toast{position:absolute;bottom:26px;left:50%;transform:translate(-50%,20px);background:#1e252d;border:1px solid #2e3742;color:#fff;padding:11px 18px;border-radius:12px;font-size:12px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:99;box-shadow:0 8px 30px rgba(0,0,0,.5);max-width:90%;text-align:center;white-space:pre-line;line-height:1.5}
.toast.on{opacity:1;transform:translate(-50%,0)}
.toast.good{border-color:rgba(14,203,129,.5)}
.toast.warn{border-color:rgba(240,185,11,.5)}
.toast.error{border-color:rgba(246,70,93,.5)}
.pf-empty{background:#0e121b;border:1px dashed #262b30;border-radius:14px;padding:26px 16px;text-align:center;color:#5e6673;font-size:12px;line-height:1.8}
.pf-empty .ico{font-size:26px;margin-bottom:8px;opacity:.7}
.pf-empty .sub{font-size:10.5px;color:#4d545e;margin-top:4px}
.up{color:#0ecb81}
.dn{color:#f6465d}
.auth-error{background:rgba(246,70,93,.1);border:1px solid rgba(246,70,93,.4);color:#f6465d;font-size:11.5px;padding:10px 14px;border-radius:10px;margin-bottom:12px;display:none;line-height:1.6}
.auth-error.show{display:block}
.chips{display:flex;gap:6px;overflow-x:auto;padding:6px 0 10px;margin:0 -16px;padding-left:16px;padding-right:16px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex-shrink:0;padding:7px 12px;border-radius:20px;background:#12161b;border:1px solid #232a31;color:#8b95a5;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;transition:.15s}
.chip.on{background:rgba(240,185,11,.15);border-color:rgba(240,185,11,.5);color:#f0b90b}
.stock-list{display:flex;flex-direction:column;gap:6px;margin-bottom:8px}
.stock-row{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#12161b,#0e1216);border:1px solid #1c222a;border-radius:13px;padding:11px 13px;cursor:pointer;transition:.15s}
.stock-row:active{background:#171d24;transform:scale(.99)}
.sr-ico{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#1e252d,#161b21);border:1px solid #232a31;display:grid;place-items:center;font-size:17px;flex-shrink:0}
.sr-info{flex:1;min-width:0}
.sr-sym{font-size:12.5px;font-weight:800;color:#eaecef;letter-spacing:.3px}
.sr-name{font-size:10px;color:#6b7480;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sr-spark{width:50px;height:22px;flex-shrink:0}
.sr-price{text-align:left;flex-shrink:0}
.sr-pr{font-size:13px;font-weight:800;color:#eaecef;font-variant-numeric:tabular-nums}
.sr-ch{font-size:10.5px;font-weight:700;margin-top:2px}
