   ============================================================ */
let tickCount=0;
function tick(){
  if(isMarketFrozen()){if(currentUser){updateLiveUI();}tickCount++;if(tickCount%7===0)saveState();return;}
  const mode=getMarketMode();const volMult=mode==='live'?1.0:0.5;
  MARKET.ret=MARKET.drift+MARKET.vol*volMult*boxMuller();
  MARKET.value=Math.max(1,MARKET.value*Math.exp(MARKET.ret));
  for(const k in SECTORS){SECTORS[k].ret=SECTORS[k].drift+SECTORS[k].vol*volMult*boxMuller();}
  for(const s of STOCKS){
    const z=boxMuller();
    const meanRev=s.kappa*Math.log(s.fair/s.price);
    const r=meanRev+s.drift+s.beta*MARKET.ret+s.gamma*(SECTORS[s.sector]?.ret||0)+s.vol*volMult*z;
    s.price=Math.max(0.01,s.price*Math.exp(r));
    s.chg=(s.price/s.open-1)*100;
    pushTick(s,s.price,Date.now(),r);
    s.spark.push(s.price);
    if(s.spark.length>400)s.spark.shift();
  }
  if(currentUser){checkOrders();updateLiveUI();}
  tickCount++;
  if(tickCount%7===0)saveState();
}
